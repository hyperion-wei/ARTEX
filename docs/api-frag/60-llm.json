        },
        "max_tokens_field": {
          "type": "string",
          "description": "输出上限所用请求字段名:空=max_tokens(默认),max_completion_tokens(仅 openai 格式有效)"
        },
        "session_header_key": {
          "type": "string",
          "description": "自定义会话头名;非空时每个请求带该头,值为当前会话/意图的 session id;空=不发送"
        },
        "retry": {
          "$ref": "#/components/schemas/LLMRetryOverride"
        }
      }
    },
    "LLMProfileInput": {
      "type": "object",
      "description": "新建/更新 LLM 档案请求。id 为 0 或省略=新建(必填 name / format / model,否则违反数据库约束);id>0=更新,api_key 留空沿用已存 key。streaming 省略=默认流式 true。",
      "required": ["name", "format", "model"],
