        "thinking_type": {
          "type": "string",
          "description": "思考开关(thinking.type):空=不发送,disabled,enabled"
        },
        "reasoning_effort": {
          "type": "string",
          "description": "思考强度:空=不发送,low/medium/high/xhigh/max"
        },
        "is_default": {
          "type": "boolean",
          "description": "是否为当前激活档案(激活档案恒为故障转移链链首)"
        },
        "priority": {
          "type": "integer",
          "description": "故障转移链排序权重,越大越靠前"
        },
        "pool_exclude": {
          "type": "boolean",
