        },
        "name": {
          "type": "string",
          "description": "档案名(数据库唯一约束)"
        },
        "format": {
          "type": "string",
          "enum": ["openai", "anthropic", "openai-responses"],
          "description": "协议格式"
        },
        "base_url": {
          "type": "string",
          "description": "API 根地址,可省略"
        },
        "proxy": {
          "type": "string",
          "description": "出站代理(http/https/socks5),可省略"
        },
        "model": {
          "type": "string",
          "description": "模型名"
        },
        "api_key": {
          "type": "string",
          "format": "password",
          "description": "API Key;新建必填,更新留空=沿用已存 key(传入即覆盖并重算 hint)"
        },
        "api_key_hint": {
          "type": "string",
          "description": "只读字段;服务端按 api_key 自动重算,传入值不生效"
        },
        "rate_per_second": {
          "type": "number",
          "format": "double",
          "description": "每秒请求上限,0=不限"
        },
        "rate_per_minute": {
          "type": "number",
          "format": "double",
          "description": "每分钟请求上限,0=不限"
        },
        "context_window_k": {
          "type": "integer",
          "description": "上下文窗口(K tokens);0=默认 200K,上限 1000"
        },
        "thinking_type": {
          "type": "string",
          "description": "思考开关(thinking.type):空=不发送,disabled,enabled"
        },
        "reasoning_effort": {
          "type": "string",
          "description": "思考强度:空=不发送,low/medium/high/xhigh/max"
        },
        "is_default": {
          "type": "boolean",
          "description": "是否激活;激活切换请用 POST /api/llm/profiles/active"
        },
        "priority": {
          "type": "integer",
          "description": "故障转移链排序权重,越大越靠前"
        },
        "pool_exclude": {
          "type": "boolean",
          "description": "true=不作为故障转移目标"
        },
        "streaming": {
          "type": "boolean",
          "nullable": true,
          "description": "收发模式:true=流式,false=非流式;省略=流式"
        },
        "max_tokens": {
          "type": "integer",
          "description": "单次回复输出上限(token);负数会归 0;0=不发送该字段"
        },
        "max_tokens_field": {
          "type": "string",
          "description": "输出上限字段名(仅 openai 格式有效,取值 max_completion_tokens;其余情况被清空)"
        },
        "session_header_key": {
          "type": "string",
          "description": "自定义会话头名,空=不发送"
        },
        "retry": {
          "$ref": "#/components/schemas/LLMRetryOverride"
        }
      }
    },
    "LLMRetryOverride": {
      "type": "object",
      "description": "档案级重试覆盖(建连/空响应/同 provider 安全窗口三层)。零值=继承全局策略,历史行为不变。",
      "required": ["connect", "empty", "stream"],
      "properties": {
        "connect": {
          "$ref": "#/components/schemas/LLMRetryRule"
        },
        "empty": {
          "$ref": "#/components/schemas/LLMRetryRule"
        },
        "stream": {
          "$ref": "#/components/schemas/LLMRetryRule"
        }
      }
    },
    "LLMRetryRule": {
      "type": "object",
      "required": ["attempts", "interval_ms"],
      "properties": {
        "attempts": {
          "type": "integer",
          "description": "重试次数:0=用默认(或继承全局),-1=显式关闭该层,大于 0=用该值;范围 [-1,20]"
        },
        "interval_ms": {
          "type": "integer",
          "description": "间隔(毫秒):0=该层默认间隔策略(通常指数退避),大于 0=固定间隔;范围 [0,3600000]"
        }
      }
    },
    "LLMRetryPolicy": {
      "type": "object",
      "description": "全局五层重试策略,每层均为一个 RetryRule(次数+间隔)。connect=SDK 建连重试(连接重置/超时/429/5xx,流开始前,默认 3 次指数退避);empty=SDK 空响应重试(完成但无 content block,仅 openai 格式,默认 2 次);stream=同 provider 安全窗口重试(未交付输出前的断流重放,默认 2 次、0.5s 起指数封顶 4s);breaker=轮询熔断(attempts=连续瞬时失败触发熔断次数,默认 3,-1=瞬时失败不熔断、硬失败仍立即熔断;interval_ms=固定冷却时长,0=默认 1/5/30 分钟梯度);intent=worker 以 model_error 收场后的整条意图重跑(默认 2 次、固定 3 秒)。connect/empty/stream 是每请求层,档案可用 LLMRetryOverride 覆盖;breaker/intent 是进程级、仅在此配置。全 0=全部走内置默认。保存时越界值自动夹取(attempts [-1,20],interval_ms [0,3600000])。",
      "required": ["connect", "empty", "stream", "breaker", "intent"],
      "properties": {
        "connect": {
          "$ref": "#/components/schemas/LLMRetryRule"
        },
        "empty": {
          "$ref": "#/components/schemas/LLMRetryRule"
        },
        "stream": {
          "$ref": "#/components/schemas/LLMRetryRule"
        },
        "breaker": {
          "$ref": "#/components/schemas/LLMRetryRule"
        },
        "intent": {
          "$ref": "#/components/schemas/LLMRetryRule"
        }
      }
    },
    "LLMPoolStatus": {
      "type": "object",
      "required": ["enabled", "bind_fallback", "chain"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "故障转移(轮询)总开关"
        },
        "bind_fallback": {
          "type": "boolean",
          "description": "显式绑定档案的兜底开关:开=绑定档案失败也回落到链,关=绑定档案独占(默认)"
        },
        "chain": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/LLMPoolMemberStatus"
          },
          "description": "链路成员(激活优先,其次 priority 降序);被排除的档案也列出并标记"
        }
      }
    },
    "LLMPoolMemberStatus": {
      "type": "object",
      "description": "轮询链中的一个成员及其熔断健康状态。",
      "required": [
        "profile_id",
        "name",
        "model",
        "format",
        "priority",
        "active",
        "excluded",
        "state",
        "fails",
        "trips",
        "cooldown_secs"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "description": "档案 ID(数字字符串)"
        },
        "name": {
          "type": "string",
          "description": "档案名"
        },
        "model": {
          "type": "string",
          "description": "模型名"
        },
        "format": {
          "type": "string",
          "description": "协议格式"
        },
        "priority": {
          "type": "integer",
          "description": "排序权重"
        },
        "active": {
          "type": "boolean",
          "description": "是否为全局激活档案"
        },
        "excluded": {
          "type": "boolean",
          "description": "是否被 pool_exclude 排除出故障转移链"
        },
        "state": {
          "type": "string",
          "enum": ["ok", "degraded", "tripped"],
          "description": "熔断状态:ok=正常,degraded=有失败但未熔断,tripped=已熔断冷却中"
        },
        "fails": {
          "type": "integer",
          "description": "当前连续失败次数"
        },
        "trips": {
          "type": "integer",
          "description": "累计熔断次数"
        },
        "cooldown_secs": {
          "type": "integer",
          "description": "剩余冷却秒数,0=无冷却"
        },
        "last_error": {
          "type": "string",
          "description": "最近一次失败原因,可省略"
        },
        "last_at": {
          "type": "string",
          "format": "date-time",
          "description": "最近一次熔断/失败时间(RFC3339),可省略"
        }
      }
    },
    "LLMModelsRequest": {
      "type": "object",
      "description": "拉取模型列表请求。api_key 留空时回退用 profile_id 指定档案存储的 key;无任何 key 直接返回 ok=false。",
      "properties": {
        "provider": {
          "type": "string",
          "description": "provider 格式:openai / openai-responses 走 OpenAI 模型端点,其余(含空,默认 anthropic)走 Anthropic 端点并可能回退 OpenAI 路径"
        },
        "base_url": {
          "type": "string",
          "description": "API 根地址;留空按 provider 取官方默认(openai=https://api.openai.com/v1,anthropic=https://api.anthropic.com)"
        },
        "api_key": {
          "type": "string",
          "format": "password",
          "description": "API Key(表单输入优先于档案存储的 key)"
        },
        "proxy": {
          "type": "string",
          "description": "出站代理(http/https/socks5)"
        },
        "profile_id": {
          "type": "integer",
          "format": "int64",
          "nullable": true,
          "description": "api_key 留空时,用该档案存储的 key 兜底"
        }
      }
    },
    "LLMModelsResult": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "是否成功取到模型列表(失败也返回 HTTP 200,以本字段区分)"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "模型 ID 列表,仅 ok=true 时返回(可能为空数组)"
        },
        "error": {
          "type": "string",
          "description": "失败原因(最后一个候选端点的错误),仅 ok=false 时返回"
        }
      }
    }
  }
}
