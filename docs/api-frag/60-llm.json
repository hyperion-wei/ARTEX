          "description": "API 根地址,可省略"
        },
        "proxy": {
          "type": "string",
          "description": "出站代理(http/https/socks5),可省略;空=用环境变量"
        },
        "model": {
          "type": "string",
          "description": "模型名"
        },
        "api_key_hint": {
          "type": "string",
          "description": "API Key 尾 4 位提示(…xxxx),可省略"
        },
        "rate_per_second": {
          "type": "number",
          "format": "double",
          "description": "每秒请求上限,0=不限"
        },
        "rate_per_minute": {
          "type": "number",
          "format": "double",
          "description": "每分钟请求上限,0=不限"
        },
        "context_window_k": {
          "type": "integer",
          "description": "上下文窗口(K tokens);0=默认 200K,上限 1000"
