      "required": [
        "id",
        "name",
        "format",
        "model",
        "rate_per_second",
        "rate_per_minute",
        "context_window_k",
        "thinking_type",
        "reasoning_effort",
        "is_default",
        "priority",
        "pool_exclude",
        "streaming",
        "max_tokens",
        "max_tokens_field",
        "session_header_key",
        "retry"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "档案 ID(数字字符串)"
        },
        "name": {
          "type": "string",
          "description": "档案名(唯一)"
        },
        "format": {
          "type": "string",
          "enum": ["openai", "anthropic", "openai-responses"],
