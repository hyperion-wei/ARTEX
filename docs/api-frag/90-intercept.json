{
  "paths": {
    "/api/intercept/rules": {
      "get": {
        "tags": ["intercept"],
        "summary": "获取命令拦截规则列表",
        "description": "返回全部全局命令拦截规则,按 priority 降序、id 升序排列。命令拦截是安全审批机制:工具/命令执行前先匹配规则,action=ask 时挂起等待人工 decide;action=allow/deny 直接放行或拦截并记录。",
        "operationId": "listInterceptRules",
        "responses": {
          "200": {
            "description": "规则列表",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptRuleList"}
              }
            }
          },
          "500": {
            "description": "数据库查询失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      },
      "post": {
        "tags": ["intercept"],
        "summary": "创建命令拦截规则",
        "description": "新增一条全局命令拦截规则,创建后立即生效(失效拦截器缓存)。校验:name 与 pattern 不能为空;match_target 必须是 tool_name 或 tool_input;match_type 必须是 string 或 regex,regex 时 pattern 必须能通过正则编译;action 必须是 allow、deny 或 ask。action=ask 时可配置人工审批超时(timeout_enabled/timeout_seconds/timeout_action)。",
        "operationId": "createInterceptRule",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/InterceptRuleInput"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功,返回完整规则",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptRule"}
              }
            }
          },
          "400": {
            "description": "请求体 JSON 非法或字段校验不通过",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "数据库写入失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/api/intercept/rules/{id}": {
      "put": {
        "tags": ["intercept"],
        "summary": "更新命令拦截规则",
        "description": "整体替换指定规则的全部可编辑字段,字段校验规则同创建,更新后立即生效(失效拦截器缓存)。注意:规则不存在时数据库不报 404,而是落入 500。",
        "operationId": "updateInterceptRule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "规则 ID",
            "schema": {"type": "integer", "format": "int64"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/InterceptRuleInput"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功,返回更新后的规则",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptRule"}
              }
            }
          },
          "400": {
            "description": "路径 id 非法、请求体 JSON 非法或字段校验不通过",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "数据库写入失败(含规则不存在)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      },
      "delete": {
        "tags": ["intercept"],
        "summary": "删除命令拦截规则",
        "description": "删除指定规则并失效拦截器缓存,删除后立即生效。",
        "operationId": "deleteInterceptRule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "规则 ID",
            "schema": {"type": "integer", "format": "int64"}
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["deleted"],
                  "properties": {
                    "deleted": {"type": "integer", "format": "int64", "description": "被删除的规则 ID"}
                  }
                }
              }
            }
          },
          "400": {
            "description": "路径 id 非法",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "数据库删除失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/api/intercept/rules/{id}/toggle": {
      "post": {
        "tags": ["intercept"],
        "summary": "启用或停用命令拦截规则",
        "description": "切换指定规则的 enabled 状态并失效拦截器缓存,立即生效。",
        "operationId": "toggleInterceptRule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "规则 ID",
            "schema": {"type": "integer", "format": "int64"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/InterceptRuleToggleRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "切换成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptToggleResult"}
              }
            }
          },
          "400": {
            "description": "路径 id 非法或请求体 JSON 非法",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "数据库更新失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/api/asset-intercept/rules": {
      "get": {
        "tags": ["asset-intercept"],
        "summary": "获取资产拦截规则列表",
        "description": "返回全部全局资产拦截规则(资产黑名单),内置规则在前,其余按 id 降序。与命令拦截规则匹配工具名/工具入参不同,资产拦截规则匹配的是目标资产:精确/模糊的域名、IP、URL 或 CIDR 网段。",
        "operationId": "listAssetInterceptRules",
        "responses": {
          "200": {
            "description": "规则列表",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/AssetInterceptRuleList"}
              }
            }
          },
          "500": {
            "description": "数据库查询失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      },
      "post": {
        "tags": ["asset-intercept"],
        "summary": "创建资产拦截规则",
        "description": "新增一条全局资产拦截规则(内置标记 builtin 恒为 false)。校验:pattern 不能为空(前后空白会被去除);kind 必须 exact_domain、exact_ip、exact_url、fuzzy_domain、fuzzy_ip、fuzzy_url 或 cidr;kind=exact_ip 时 pattern 必须是合法 IP 地址;kind=cidr 时 pattern 必须是合法网段(形如 192.168.0.0/16);模糊类型与域名/URL 为自由文本,格式由执行层解释。",
        "operationId": "createAssetInterceptRule",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/AssetInterceptRuleInput"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功,返回完整规则",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/AssetInterceptRule"}
              }
            }
          },
          "400": {
            "description": "请求体 JSON 非法或字段校验不通过",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "数据库写入失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
