          }
        }
      }
    },
    "/api/intercept/pending": {
      "get": {
        "tags": ["intercept"],
        "summary": "获取待审批命令列表",
        "description": "返回所有状态为 pending 的挂起审批请求,按创建时间倒序。每条记录包含被挂起的工具名、原始入参、触发来源(规则/模型兜底)与理由;action=ask 的命令执行前挂起在此处等待人工 decide。",
        "operationId": "listInterceptPending",
        "responses": {
          "200": {
            "description": "待审批列表",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptPendingList"}
              }
            }
          },
          "500": {
            "description": "数据库查询失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/api/intercept/pending/{id}": {
      "get": {
        "tags": ["intercept"],
        "summary": "获取单条待审批记录",
        "description": "按 ID 返回一条拦截挂起记录(任意状态,不限于 pending)。",
        "operationId": "getInterceptPending",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "待审批记录 ID",
            "schema": {"type": "integer", "format": "int64"}
          }
        ],
        "responses": {
          "200": {
            "description": "待审批记录",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptPending"}
              }
            }
          },
          "400": {
            "description": "路径 id 非法",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "404": {
            "description": "记录不存在",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "数据库查询失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/api/intercept/pending/{id}/decide": {
      "post": {
        "tags": ["intercept"],
        "summary": "审批挂起的命令",
        "description": "对挂起的命令做出人工审批决定:decision=allowed 放行并继续执行,decision=denied 拒绝执行。只有状态仍为 pending 的记录可被审批;已被审批(或不存在、已被超时处理)的记录返回 409。审批结果同时写回审计信息(决策理由、执行状态)。",
        "operationId": "decideInterceptPending",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "待审批记录 ID",
            "schema": {"type": "integer", "format": "int64"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/InterceptDecisionRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "审批成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok"],
                  "properties": {
                    "ok": {"type": "boolean"}
                  }
                }
              }
            }
          },
          "400": {
            "description": "路径 id 非法、请求体 JSON 非法或 decision 取值不合法",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "409": {
            "description": "该记录已被审批(或不存在),不能重复决定",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "审批落库失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/api/intercept/history": {
      "get": {
        "tags": ["intercept"],
        "summary": "查询拦截审批历史",
        "description": "分页查询全部拦截审批历史(含 pending/allowed/denied/timeout 各状态),按创建时间倒序,并关联对话标题与命中规则名。双模式:不传 page/size 且不带过滤参数时,返回最近 200 条且响应不含分页字段(total 为本页条数);一旦传入 page/size 或任一过滤参数,则按分页返回(total 为符合条件的总条数)。status 过滤审批状态,decision_source 过滤决策来源(规则命中/模型兜底/未知)。",
        "operationId": "listInterceptHistory",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "按审批状态过滤,空为全部",
            "schema": {"type": "string", "enum": ["pending", "allowed", "denied", "timeout"]}
          },
          {
            "name": "decision_source",
            "in": "query",
            "required": false,
            "description": "按决策来源过滤,空为全部",
            "schema": {"type": "string", "enum": ["model", "rule", "unknown"]}
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码,从 1 开始,默认 1;与 size 或过滤参数同时出现时启用分页",
            "schema": {"type": "integer", "minimum": 1, "default": 1}
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "每页条数,默认 20,最大 100",
            "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}
          }
        ],
        "responses": {
          "200": {
            "description": "审批历史列表(分页字段仅分页模式返回)",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptHistoryList"}
              }
            }
          },
          "400": {
            "description": "status 或 decision_source 取值不合法",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "数据库查询失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/api/intercept/history/{id}": {
      "get": {
        "tags": ["intercept"],
        "summary": "获取审批历史详情",
        "description": "按 ID 返回一条审批记录的详情:在列表字段(含对话标题、规则名)基础上附带完整 audit 审计信息——审批时捕获的用户消息与上下文、模型兜底的输入与裁决、人工决定与执行状态等。audit 为 null 表示旧记录未保存审计。",
        "operationId": "getInterceptHistoryDetail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "审批记录 ID(须大于 0)",
            "schema": {"type": "integer", "format": "int64", "minimum": 1}
          }
        ],
        "responses": {
          "200": {
            "description": "审批详情",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptHistoryDetail"}
              }
            }
          },
          "400": {
            "description": "路径 id 非法",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "404": {
            "description": "记录不存在",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "数据库查询失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/api/intercept/history/{id}/execution": {
      "get": {
        "tags": ["intercept"],
        "summary": "定位审批对应的命令执行记录",
        "description": "根据审批记录 audit 中保存的关联 ID(run_id/tool_use_id,correlation 须为 exact)精确定位原始工具调用及其配对的执行结果,返回所属对话/任务、会话定位符(session)与活动条目(items,kind 为 tool_use/tool_result),用于跳转到命令执行记录。仅返回该次调用与配对结果,不会回退到命令文本匹配。无法唯一关联时返回 409;任务或会话已删除时返回 410。",
        "operationId": "getInterceptExecution",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "审批记录 ID(须大于 0)",
            "schema": {"type": "integer", "format": "int64", "minimum": 1}
          },
          {
            "name": "conversation",
            "in": "query",
            "required": false,
            "description": "可选的对话 ID;当审批记录本身已被删除时,用于给出精确报错(对话是否存在),不影响正常查询",
            "schema": {"type": "integer", "format": "int64", "minimum": 1}
          }
        ],
        "responses": {
          "200": {
            "description": "原始工具调用及配对结果",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptExecutionResult"}
              }
            }
          },
          "400": {
            "description": "路径 id 非法",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "404": {
            "description": "审批记录已被删除或不存在",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "409": {
            "description": "未找到可唯一关联的原始工具调用(记录可能已删除,或旧审批没有保存关联 ID)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "410": {
            "description": "任务/会话/对话已被删除(Gone)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "数据库查询失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/api/intercept/task/{taskID}": {
      "get": {
        "tags": ["intercept"],
        "summary": "查询任务的拦截审批记录",
        "description": "返回指定任务(task_id 精确匹配)的全部拦截审批记录,按创建时间倒序,关联对话标题与规则名。过滤与分页逻辑同审批历史:不带 page/size 且无过滤时返回该任务全部记录(响应不含分页字段);带任一分页或过滤参数时按分页返回。",
        "operationId": "listTaskIntercepts",
        "parameters": [
          {
            "name": "taskID",
            "in": "path",
            "required": true,
            "description": "任务 ID(字符串)",
            "schema": {"type": "string", "minLength": 1}
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "按审批状态过滤,空为全部",
            "schema": {"type": "string", "enum": ["pending", "allowed", "denied", "timeout"]}
          },
          {
            "name": "decision_source",
            "in": "query",
            "required": false,
            "description": "按决策来源过滤,空为全部",
            "schema": {"type": "string", "enum": ["model", "rule", "unknown"]}
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码,从 1 开始,默认 1;与 size 或过滤参数同时出现时启用分页",
            "schema": {"type": "integer", "minimum": 1, "default": 1}
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "每页条数,默认 20,最大 100",
            "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}
          }
        ],
        "responses": {
          "200": {
            "description": "该任务的审批记录(分页字段仅分页模式返回)",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptHistoryList"}
              }
            }
          },
          "400": {
            "description": "taskID 为空或 status/decision_source 取值不合法",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "数据库查询失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "503": {
            "description": "管理后台数据源(PostgreSQL)未连接",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/api/intercept/tool-config": {
      "get": {
        "tags": ["intercept"],
        "summary": "获取纳入拦截的工具清单",
        "description": "返回当前配置为进入拦截规则体系的工具名列表;只有清单内的工具调用会经过命令拦截规则与兜底审批。",
        "operationId": "getInterceptToolConfig",
        "responses": {
          "200": {
            "description": "工具清单",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptToolConfig"}
              }
            }
          },
          "500": {
            "description": "读取配置失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      },
      "put": {
        "tags": ["intercept"],
        "summary": "设置纳入拦截的工具清单",
        "description": "整体替换纳入拦截规则体系的工具名列表(enabled_tools)。传 null 或缺省时视为空数组,即所有工具都不再进入拦截。",
        "operationId": "setInterceptToolConfig",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/InterceptToolConfig"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "设置成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok"],
                  "properties": {
                    "ok": {"type": "boolean"}
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求体 JSON 非法",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "保存配置失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/api/intercept/judge": {
      "get": {
        "tags": ["intercept"],
        "summary": "获取 LLM 兜底审批配置",
        "description": "返回兜底审批(LLM 裁判)的已解析生效配置:未命中任何规则的工具调用在启用时交由 LLM 做一次 JSON 分类裁决。prompt 为生效值(未自定义时返回内置模板,便于前端预填);profile_id=0 表示跟随当前激活/默认模型;fail_action 是裁判调用失败时的兜底动作;ask_timeout_* 是裁判裁决转人工后的等待与超时策略。",
        "operationId": "getInterceptJudgeConfig",
        "responses": {
          "200": {
            "description": "兜底审批配置",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptJudgeConfig"}
              }
            }
          }
        }
      },
      "put": {
        "tags": ["intercept"],
        "summary": "设置 LLM 兜底审批配置",
        "description": "持久化兜底审批(LLM 裁判)配置。校验:fail_action 必须是 allow、ask 或 deny;ask_timeout_action 必须是 allow 或 deny。prompt 留空(或与内置模板一致)时清除自定义覆盖,后续版本更新内置模板会自动生效;profile_id=0 表示跟随当前激活/默认模型。",
        "operationId": "setInterceptJudgeConfig",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/InterceptJudgeConfig"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "设置成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok"],
                  "properties": {
                    "ok": {"type": "boolean"}
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求体 JSON 非法,或 fail_action/ask_timeout_action 取值不合法",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "保存配置失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/api/intercept/judge/usage": {
      "get": {
        "tags": ["intercept"],
        "summary": "查询兜底审批 token 用量",
        "description": "返回 LLM 兜底审批的累计 token 用量与最近每日序列,供配置页展示。数据来自常开 llm_usage 台账中 worker='judge' 的记录,统计准确覆盖连接池轮转与中断的裁判调用。days 仅限制每日序列的回看天数(默认 30,非正数按 30 处理),累计总量始终为全部历史。",
        "operationId": "getInterceptJudgeUsage",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "每日序列回看天数,默认 30,非正数按 30 处理;不影响累计总量",
            "schema": {"type": "integer", "default": 30}
          }
        ],
        "responses": {
          "200": {
            "description": "兜底审批用量统计",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/InterceptJudgeUsage"}
              }
            }
          },
          "500": {
            "description": "数据库查询失败",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    }
  },
  "schemas": {
    "InterceptRule": {
      "type": "object",
      "description": "全局命令拦截规则(intercept_rules 一行)。工具/命令执行前按 priority 降序匹配,首个命中的启用规则生效。",
      "required": ["id", "name", "enabled", "priority", "match_target", "match_type", "pattern", "action", "message", "timeout_enabled", "timeout_seconds", "timeout_action", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "integer", "format": "int64", "description": "规则 ID"},
        "name": {"type": "string", "description": "规则名称"},
        "enabled": {"type": "boolean", "description": "是否启用"},
        "priority": {"type": "integer", "description": "优先级,数值越大越先匹配;列表按 priority 降序排列"},
        "match_target": {"type": "string", "enum": ["tool_name", "tool_input"], "description": "匹配对象:工具名或工具入参"},
        "match_type": {"type": "string", "enum": ["string", "regex"], "description": "匹配方式:字符串或正则"},
        "pattern": {"type": "string", "description": "匹配模式;match_type=regex 时须为合法正则"},
        "action": {"type": "string", "enum": ["allow", "deny", "ask"], "description": "命中后的动作:放行/拦截/转人工审批"},
        "message": {"type": "string", "description": "命中规则时的说明文案,空时使用内置默认文案"},
        "timeout_enabled": {"type": "boolean", "description": "action=ask 时是否启用人工审批等待超时"},
        "timeout_seconds": {"type": "integer", "description": "人工审批等待超时秒数"},
        "timeout_action": {"type": "string", "enum": ["allow", "deny"], "description": "审批超时后的处理动作"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "InterceptRuleInput": {
      "type": "object",
      "description": "创建/更新命令拦截规则的请求体。",
      "required": ["name", "match_target", "match_type", "pattern", "action"],
      "properties": {
        "name": {"type": "string", "description": "规则名称,不能为空"},
        "enabled": {"type": "boolean", "description": "是否启用,默认 false"},
        "priority": {"type": "integer", "description": "优先级,数值越大越先匹配"},
        "match_target": {"type": "string", "enum": ["tool_name", "tool_input"], "description": "匹配对象:工具名或工具入参"},
        "match_type": {"type": "string", "enum": ["string", "regex"], "description": "匹配方式:字符串或正则;regex 时 pattern 必须能通过正则编译"},
        "pattern": {"type": "string", "description": "匹配模式,不能为空"},
        "action": {"type": "string", "enum": ["allow", "deny", "ask"], "description": "命中后的动作:放行/拦截/转人工审批"},
        "message": {"type": "string", "description": "命中规则时的说明文案"},
        "timeout_enabled": {"type": "boolean", "description": "action=ask 时是否启用人工审批等待超时"},
        "timeout_seconds": {"type": "integer", "description": "人工审批等待超时秒数"},
        "timeout_action": {"type": "string", "enum": ["allow", "deny"], "description": "审批超时后的处理动作"}
      }
    },
    "InterceptRuleToggleRequest": {
      "type": "object",
      "description": "启用/停用规则的请求体(命令拦截规则与资产拦截规则通用)。",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean", "description": "目标状态"}
      }
    },
    "InterceptRuleList": {
      "type": "object",
      "description": "命令拦截规则列表响应。",
      "required": ["rules"],
      "properties": {
        "rules": {"type": "array", "items": {"$ref": "#/components/schemas/InterceptRule"}, "description": "规则列表,按 priority 降序、id 升序;无规则时为空数组"}
      }
    },
    "InterceptToggleResult": {
      "type": "object",
      "description": "规则启用/停用结果。",
      "required": ["ok", "enabled"],
      "properties": {
        "ok": {"type": "boolean"},
        "enabled": {"type": "boolean", "description": "切换后的状态"}
      }
    },
    "AssetInterceptRule": {
      "type": "object",
      "description": "全局资产拦截规则(asset_intercept_rules 一行),匹配目标资产而非工具调用。",
      "required": ["id", "enabled", "kind", "pattern", "note", "builtin", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "integer", "format": "int64", "description": "规则 ID"},
        "enabled": {"type": "boolean", "description": "是否启用"},
        "kind": {"type": "string", "enum": ["exact_domain", "exact_ip", "exact_url", "fuzzy_domain", "fuzzy_ip", "fuzzy_url", "cidr"], "description": "匹配类型:精确/模糊的域名、IP、URL 或 CIDR 网段"},
        "pattern": {"type": "string", "description": "匹配模式;exact_ip 须为合法 IP,cidr 须为合法网段,模糊类型与域名/URL 为自由文本"},
        "note": {"type": "string", "description": "备注"},
        "builtin": {"type": "boolean", "description": "是否内置规则(内置规则在前展示)"},
        "action": {"type": "string", "enum": ["block", "allow"], "description": "仅任务级规则携带:block=拦截、allow=允许(白名单);全局规则恒为空,视为拦截"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "AssetInterceptRuleInput": {
      "type": "object",
      "description": "创建/更新资产拦截规则的请求体。",
      "required": ["kind", "pattern"],
      "properties": {
        "enabled": {"type": "boolean", "description": "是否启用,默认 false"},
        "kind": {"type": "string", "enum": ["exact_domain", "exact_ip", "exact_url", "fuzzy_domain", "fuzzy_ip", "fuzzy_url", "cidr"], "description": "匹配类型"},
        "pattern": {"type": "string", "description": "匹配模式,不能为空(前后空白会被去除)"},
        "note": {"type": "string", "description": "备注"}
      }
    },
    "AssetInterceptRuleList": {
      "type": "object",
      "description": "资产拦截规则列表响应。",
      "required": ["rules"],
      "properties": {
        "rules": {"type": "array", "items": {"$ref": "#/components/schemas/AssetInterceptRule"}, "description": "规则列表,内置在前、其余按 id 降序;无规则时为空数组"}
      }
    },
    "InterceptPending": {
      "type": "object",
      "description": "一条拦截挂起/审批记录(intercept_pending 一行)。",
      "required": ["id", "agent_name", "tool_name", "tool_input", "status", "decision_source", "reason", "created_at"],
      "properties": {
        "id": {"type": "integer", "format": "int64", "description": "记录 ID"},
        "rule_id": {"type": "integer", "format": "int64", "nullable": true, "description": "命中的规则 ID;null 表示 LLM 兜底裁判,无归属规则"},
        "conversation_id": {"type": "integer", "format": "int64", "nullable": true, "description": "所属对话 ID;null 表示后台任务"},
        "task_id": {"type": "string", "nullable": true, "description": "所属任务 ID;null 表示对话场景"},
        "agent_name": {"type": "string", "description": "发起工具调用的 agent 名称"},
        "tool_name": {"type": "string", "description": "被拦截的工具名"},
        "tool_input": {"type": "object", "additionalProperties": true, "description": "工具调用的原始入参(任意 JSON,通常为对象;空入参存储为 {})"},
        "status": {"type": "string", "enum": ["pending", "allowed", "denied", "timeout"], "description": "审批状态"},
        "decision_source": {"type": "string", "enum": ["model", "rule", "unknown"], "description": "决策来源:规则命中/模型兜底/未知(旧记录)"},
        "reason": {"type": "string", "description": "理由:规则 message,或模型判定理由(带 [模型] 前缀)"},
        "decided_at": {"type": "string", "format": "date-time", "nullable": true, "description": "决定时间;未决定时为 null"},
        "created_at": {"type": "string", "format": "date-time", "description": "创建(挂起)时间"}
      }
    },
    "InterceptPendingList": {
      "type": "object",
      "description": "待审批列表响应。",
      "required": ["pending"],
      "properties": {
        "pending": {"type": "array", "items": {"$ref": "#/components/schemas/InterceptPending"}, "description": "状态为 pending 的记录,按创建时间倒序;无待审批时为空数组"}
      }
    },
    "InterceptDecisionRequest": {
      "type": "object",
      "description": "人工审批决定请求体。",
      "required": ["decision"],
      "properties": {
        "decision": {"type": "string", "enum": ["allowed", "denied"], "description": "allowed=放行并继续执行;denied=拒绝执行"}
      }
    },
    "InterceptHistoryItem": {
      "type": "object",
      "description": "审批历史列表项:拦截记录关联对话标题与命中规则名。",
      "allOf": [
        {"$ref": "#/components/schemas/InterceptPending"},
        {
          "type": "object",
          "required": ["conv_title", "conv_agent_key", "rule_name"],
          "properties": {
            "conv_title": {"type": "string", "description": "所属对话标题,无关联时为空字符串"},
            "conv_agent_key": {"type": "string", "description": "所属对话的 agent key,无关联时为空字符串"},
            "rule_name": {"type": "string", "description": "命中的规则名,无关联时为空字符串"}
          }
        }
      ]
    },
    "InterceptHistoryDetail": {
      "type": "object",
      "description": "审批历史详情:列表字段附带完整审计信息。",
      "allOf": [
        {"$ref": "#/components/schemas/InterceptHistoryItem"},
        {
          "type": "object",
          "required": ["audit"],
          "properties": {
            "audit": {"nullable": true, "allOf": [{"$ref": "#/components/schemas/InterceptAudit"}], "description": "审批时捕获的审计信息;旧记录未保存时为 null"}
          }
        }
      ]
    },
    "InterceptAudit": {
      "type": "object",
      "description": "审批记录的审计信息:审批时捕获的上下文、模型兜底裁决、人工决定与执行结果追踪。",
      "required": ["correlation", "input_digest", "user_message", "context", "captured_at", "initial_action", "initial_reason", "execution_status"],
      "properties": {
        "run_id": {"type": "string", "description": "关联的运行 ID"},
        "tool_use_id": {"type": "string", "description": "关联的工具调用 ID,execution 定位依赖此字段"},
        "correlation": {"type": "string", "enum": ["exact", "ambiguous", "unavailable"], "description": "与原始工具调用的关联精确度;仅 exact 可定位执行记录"},
        "input_digest": {"type": "string", "description": "工具入参摘要"},
        "user_message": {"type": "string", "description": "审批时捕获的用户消息"},
        "user_truncated": {"type": "boolean", "description": "用户消息是否被截断"},
        "context": {"type": "array", "items": {"$ref": "#/components/schemas/InterceptContextEntry"}, "description": "审批时记录的会话事件(有界)"},
        "context_truncated": {"type": "boolean", "description": "上下文是否被截断"},
        "captured_at": {"type": "string", "format": "date-time", "description": "审计捕获时间"},
        "model_fallback": {"type": "boolean", "description": "该次决定是否走了模型兜底"},
        "model_input": {"type": "object", "nullable": true, "additionalProperties": true, "description": "模型兜底调用的输入原文(任意 JSON)"},
        "model_input_digest": {"type": "string", "description": "模型输入摘要"},
        "initial_action": {"type": "string", "enum": ["allow", "deny", "ask"], "description": "初始动作"},
        "initial_reason": {"type": "string", "description": "初始理由"},
        "effective_action": {"type": "string", "enum": ["allow", "deny"], "description": "生效动作(人工决定或超时后)"},
        "decision_reason": {"type": "string", "description": "最终决定理由(如:人工允许执行)"},
        "rule_name": {"type": "string", "description": "命中的规则名"},
        "config_digest": {"type": "string", "description": "命中规则/配置摘要"},
        "profile_id": {"type": "integer", "format": "int64", "description": "模型兜底使用的 profile ID"},
        "execution_status": {"type": "string", "enum": ["not_executed", "awaiting_result", "succeeded", "failed", "unknown"], "description": "放行后的执行状态追踪"},
        "output": {"type": "string", "description": "放行后的执行输出"},
        "output_truncated": {"type": "boolean", "description": "输出是否被截断"},
        "execution_ended_at": {"type": "string", "format": "date-time", "nullable": true, "description": "执行结束时间"}
      }
    },
    "InterceptContextEntry": {
      "type": "object",
      "description": "审批时记录的单条有界会话事件(非模型推理内容)。",
      "required": ["kind", "text"],
      "properties": {
        "kind": {"type": "string", "description": "事件类型"},
        "tool": {"type": "string", "description": "相关工具名"},
        "tool_use_id": {"type": "string", "description": "相关工具调用 ID"},
        "text": {"type": "string", "description": "事件文本"},
        "is_error": {"type": "boolean", "description": "是否为错误事件"},
        "truncated": {"type": "boolean", "description": "文本是否被截断"}
      }
    },
    "InterceptHistoryList": {
      "type": "object",
      "description": "审批历史/任务审批记录列表响应。非分页模式(无 page/size 且无过滤)不含 page/page_size 字段,最多返回 200 条(任务维度为全部)。",
      "required": ["items", "total"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/components/schemas/InterceptHistoryItem"}, "description": "记录列表,按创建时间倒序"},
        "total": {"type": "integer", "description": "总条数;非分页模式为本页条数"},
        "page": {"type": "integer", "description": "当前页码(从 1 开始),仅分页模式返回"},
        "page_size": {"type": "integer", "description": "每页条数,仅分页模式返回"}
      }
    },
    "InterceptExecutionResult": {
      "type": "object",
      "description": "审批对应的命令执行记录定位结果:原始工具调用及其配对结果。",
      "required": ["conversation_id", "task_id", "session", "seq", "items"],
      "properties": {
        "conversation_id": {"type": "integer", "format": "int64", "nullable": true, "description": "所属对话 ID;任务来源时为 null"},
        "task_id": {"type": "string", "nullable": true, "description": "所属任务 ID;对话来源时为 null"},
        "session": {"type": "string", "description": "会话定位符:任务来源为 main:N/plan/intent:N,对话来源为空字符串"},
        "seq": {"type": "integer", "format": "int64", "description": "原始工具调用(activity)的序号"},
        "items": {"type": "array", "items": {"$ref": "#/components/schemas/InterceptExecutionItem"}, "description": "原始 tool_use 调用及其配对的 tool_result(若有)"}
      }
    },
    "InterceptExecutionItem": {
      "type": "object",
      "description": "执行记录中的单条活动(工具调用或工具结果)。",
      "required": ["seq", "worker", "ts", "kind", "is_error", "summary"],
      "properties": {
        "seq": {"type": "integer", "format": "int64", "description": "活动序号"},
        "intent_id": {"type": "string", "description": "关联的意图节点 ID"},
        "worker": {"type": "string", "description": "来源 worker(如 mainagent/planner)"},
        "ts": {"type": "string", "format": "date-time", "description": "活动时间(RFC3339)"},
        "kind": {"type": "string", "enum": ["tool_use", "tool_result"], "description": "活动类型:工具调用或工具结果"},
        "tool": {"type": "string", "description": "工具名"},
        "tool_use_id": {"type": "string", "description": "工具调用 ID"},
        "is_error": {"type": "boolean", "description": "是否为错误"},
        "summary": {"type": "string", "description": "摘要"},
        "detail": {"type": "string", "description": "详情(此端点不填充)"},
        "metadata": {"type": "object", "nullable": true, "additionalProperties": true, "description": "元数据(任意 JSON)"},
        "source_task_id": {"type": "string", "description": "来源任务 ID(继承活动时)"},
        "inherited": {"type": "boolean", "description": "是否为继承活动"},
        "main_seg": {"type": "integer", "nullable": true, "description": "main-agent 会话分段;非 mainagent 行为 null"},
        "input_tokens": {"type": "integer", "nullable": true, "description": "输入 token(仅 result 类活动)"},
        "output_tokens": {"type": "integer", "nullable": true, "description": "输出 token(仅 result 类活动)"},
        "cache_read_tokens": {"type": "integer", "nullable": true, "description": "缓存读 token(仅 result 类活动)"},
        "cache_write_tokens": {"type": "integer", "nullable": true, "description": "缓存写 token(仅 result 类活动)"}
      }
    },
    "InterceptToolConfig": {
      "type": "object",
      "description": "纳入拦截规则体系的工具清单(请求体与响应共用;请求时 null 视为空数组)。",
      "required": ["enabled_tools"],
      "properties": {
        "enabled_tools": {"type": "array", "items": {"type": "string"}, "description": "进入拦截的工具名列表;空数组表示无工具进入拦截"}
      }
    },
    "InterceptJudgeConfig": {
      "type": "object",
      "description": "LLM 兜底审批(裁判)配置,请求与响应共用。GET 返回已解析的生效配置(prompt 为生效值);PUT 时 prompt 留空表示清除自定义、恢复内置模板。",
      "required": ["enabled", "profile_id", "prompt", "timeout_seconds", "fail_action", "ask_timeout_seconds", "ask_timeout_action"],
      "properties": {
        "enabled": {"type": "boolean", "description": "是否启用 LLM 兜底审批(未命中规则的工具调用交由模型裁决)"},
        "profile_id": {"type": "integer", "format": "int64", "description": "裁判模型 profile ID;0 表示跟随当前激活/默认 profile"},
        "prompt": {"type": "string", "description": "裁判系统提示词;GET 返回生效值(未自定义时为内置模板),PUT 留空清除自定义"},
        "timeout_seconds": {"type": "integer", "description": "裁判模型调用超时秒数"},
        "fail_action": {"type": "string", "enum": ["allow", "ask", "deny"], "description": "裁判调用失败(不可用/格式无效/超时)时的兜底动作"},
        "ask_timeout_seconds": {"type": "integer", "description": "裁决为转人工后的等待审批秒数"},
        "ask_timeout_action": {"type": "string", "enum": ["allow", "deny"], "description": "转人工后等待超时的处理动作"}
      }
    },
    "InterceptJudgeUsage": {
      "type": "object",
      "description": "兜底审批累计 token 用量与每日序列。",
      "required": ["calls", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "daily"],
      "properties": {
        "calls": {"type": "integer", "description": "累计裁判调用次数"},
        "input_tokens": {"type": "integer", "description": "累计输入 token"},
        "output_tokens": {"type": "integer", "description": "累计输出 token"},
        "cache_read_tokens": {"type": "integer", "description": "累计缓存读 token"},
        "cache_write_tokens": {"type": "integer", "description": "累计缓存写 token"},
        "daily": {"type": "array", "items": {"$ref": "#/components/schemas/InterceptJudgeDayUsage"}, "description": "最近 days 天(默认 30)的每日用量序列,按日期升序"}
      }
    },
    "InterceptJudgeDayUsage": {
      "type": "object",
      "description": "兜底审批单日(UTC)token 用量。",
      "required": ["date", "calls", "input_tokens", "output_tokens"],
      "properties": {
        "date": {"type": "string", "format": "date", "description": "日期,YYYY-MM-DD(UTC)"},
        "calls": {"type": "integer", "description": "当日调用次数"},
        "input_tokens": {"type": "integer", "description": "当日输入 token"},
        "output_tokens": {"type": "integer", "description": "当日输出 token"}
      }
    }
  }
}
